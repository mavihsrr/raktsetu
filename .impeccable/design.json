      "css": ".ds-gate{border-radius:10px;padding:14px;border:1px solid rgba(245,181,68,.35);background:rgba(245,181,68,.13);color:#ffe2a8;font:14px/1.5 ui-sans-serif,system-ui,sans-serif}.ds-gate p{margin:0}.ds-gate-q{font-weight:600;margin-bottom:4px}.ds-gate-sub{font-size:13px;color:#a3a6b8;margin-bottom:12px}.ds-gate-actions{display:flex;gap:8px;justify-content:flex-end}.ds-gbtn{height:34px;padding:0 14px;border-radius:6px;border:1px solid #2f2f3d;background:#17171f;color:#f2f2f5;font:550 13px ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-gbtn:hover{background:#1d1d27}.ds-gbtn-p{background:#f2f2f5;color:#0b0b0f;border-color:#f2f2f5}.ds-gbtn-p:hover{background:#fff}"
    },
    {
      "name": "Call Row",
      "kind": "custom",
      "refersTo": "call-row",
      "description": "Live bank call with state icon, meta, phone-confirmed result.",
      "html": "<div class=\"ds-call\"><span class=\"ds-dial\"></span><span class=\"ds-call-body\"><span class=\"ds-call-name\">Rotary Blood Bank</span><span class=\"ds-call-meta\">2.4 km · portal says 6</span></span><span class=\"ds-units\">3 <small>units</small></span></div>",
      "css": ".ds-call{display:grid;grid-template-columns:20px 1fr auto;gap:10px;align-items:center;padding:9px 8px;border-radius:6px;font-family:ui-sans-serif,system-ui,sans-serif;color:#f2f2f5;cursor:pointer;transition:background .4s cubic-bezier(0.16,1,0.3,1)}.ds-call:hover{background:#1d1d27}.ds-dial{position:relative;width:9px;height:9px;border-radius:50%;background:#7cb4ff;justify-self:center}.ds-dial::after{content:'';position:absolute;inset:-5px;border-radius:50%;border:1.5px solid #7cb4ff;animation:ds-ring 1.4s cubic-bezier(0.16,1,0.3,1) infinite}@keyframes ds-ring{from{transform:scale(.5);opacity:1}to{transform:scale(1.3);opacity:0}}.ds-call-body{display:grid;gap:2px;min-width:0}.ds-call-name{font-size:13.5px;font-weight:550}.ds-call-meta{font-size:12px;color:#8a8da0}.ds-units{font-size:15px;font-weight:650;font-variant-numeric:tabular-nums}.ds-units small{font-size:11.5px;font-weight:450;color:#a3a6b8}"
