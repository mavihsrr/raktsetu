      "css": ".ds-chip{font:12px ui-sans-serif,system-ui,sans-serif;padding:3px 10px;border-radius:99px;background:#17171f;color:#a3a6b8;border:1px solid #23232e}.ds-chip-live{background:#c2334a;color:#fff;border-color:transparent}.ds-pill{font:600 11.5px ui-sans-serif,system-ui,sans-serif;padding:2px 9px;border-radius:99px;white-space:nowrap}.ds-pill-calling{background:rgba(124,180,255,.12);color:#7cb4ff}.ds-pill-wait{background:rgba(245,181,68,.13);color:#f5b544}.ds-pill-ok{background:rgba(74,222,128,.12);color:#4ade80}"
