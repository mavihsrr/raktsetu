# Copy to .env and fill in. Never commit .env. Never put these in browser code or chat.

# --- backend ---
TOOL_SECRET=change-me-long-random          # Sarvam intake tools send this as X-Tool-Secret
WEBHOOK_SECRET=change-me-long-random       # signs per-call webhook URLs
DASHBOARD_TOKEN=                           # optional; open dashboard as /#token=<value>
PUBLIC_BASE_URL=http://localhost:8000      # cloudflared URL once tunnelled (Sarvam must reach it)
SIM_SPEED=1.0                              # simulated call duration multiplier (0.3 = faster demo)
DB_PATH=./data/raktsetu.db

# --- Sarvam (outbound caller agents + rented number) ---
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE=                        # the rented number, E.164 e.g. +9180xxxxxxx
SARVAM_BANK_APP_ID=
SARVAM_BANK_APP_VERSION=
SARVAM_DONOR_APP_ID=
SARVAM_DONOR_APP_VERSION=
SARVAM_INTAKE_APP_ID=                      # used by voice/intake_voice.py
SARVAM_INTAKE_APP_VERSION=

# Only these targets are ever dialled for real (teammates' phones). Everything else is SIM.
# Format: bank:<id>=<phone>,donor:<id>=<phone>   e.g. bank:B05=+9198xxxxxxxx,donor:D01=+9197xxxxxxxx
LIVE_TARGETS=

# Our own phone(s) that stand in for real banks while the Flagsmith flag call_real_banks is off.
# Comma-separated E.164, e.g. +9198xxxxxxxx
DEMO_BANK_PHONES=

# --- Flagsmith (server-side environment key) ---
FLAGSMITH_ENVIRONMENT_KEY=
# LOCAL_FLAGS_PATH=./flags.local.json       # optional fallback file when offline

# --- NudgeBee (only if their team confirms an inbound webhook trigger) ---
NUDGEBEE_WEBHOOK_URL=
